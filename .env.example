# قاعدة PostgreSQL مستضافة (Neon أو Supabase) — لا Docker.
# DATABASE_URL: الرابط المستخدم وقت التشغيل (يمكن أن يكون عبر pooler).
# DIRECT_URL: الرابط المباشر للترحيلات. إن لم يوجد pooler ضع القيمة نفسها في الاثنين.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# المرحلة 2 (المصادقة): سلسلة عشوائية طويلة (openssl rand -base64 32 أو أي مولّد سري)
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
